{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "exclude": [
        ".env",
        ".env.*",
        "!.env.example",
        ".local",
        ".git",
        "storage/app/private/**",
        "storage/logs/**",
        "public/hot"
    ],
    "deploy": {
        "aptPackages": ["supervisor"],
        "startCommand": "bash railway/start.sh"
    }
}
